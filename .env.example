# Database
# Local: ambas iguales.
DATABASE_URL="postgresql://user:password@localhost:5432/maurizone_local?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/maurizone_local?schema=public"
# Neon (producción): DATABASE_URL = host con "-pooler" (PgBouncer); DIRECT_URL = host sin "-pooler" (prisma migrate)
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# JWT
JWT_SECRET=your-secret
JWT_EXPIRES_IN=7d

# OTP provider: local (por defecto) o twilio
# OTP_PROVIDER=local
# OTP_PROVIDER=twilio

# Con OTP_PROVIDER=local: si NODE_ENV !== "production", se permite código 000000 y se devuelve devOtp en POST /auth/otp/request
# NODE_ENV=development

# Twilio Verify (solo si OTP_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=ACxxx
# TWILIO_AUTH_TOKEN=xxx
# TWILIO_VERIFY_SERVICE_SID=VAxxx

# Admin bootstrap: solo permite crear el primer ADMIN si no existe ninguno.
# Header requerido: x-admin-bootstrap-secret
ADMIN_BOOTSTRAP_SECRET=some-long-random-string

# Moosyl (pagos MRU - Bankily, Sedad, Masrivi)
# Obtener keys en https://console.moosyl.com/
# Testing: https://docs.moosyl.com/testing - usar teléfonos 22222222, 33333333, 44444444 para simular pagos completados
MOOSYL_SECRET_KEY=sk_test_xxx
MOOSYL_PUBLIC_KEY=pk_test_xxx
MOOSYL_WEBHOOK_SECRET=whsec_xxx
